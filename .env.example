# Copy to .env and edit. Everything here is optional; defaults are shown.
# Never commit .env — it will hold API keys in later stages.

# Folder containing ffmpeg.exe and ffprobe.exe (only needed if FFmpeg isn't found automatically)
# FFMPEG_DIR=C:\path\to\ffmpeg\bin

# Piper voice model (.onnx, with its .onnx.json next to it)
PIPER_VOICE=voices/en_US-lessac-medium.onnx

# Video rules
MAX_DURATION=60
# How far still images slowly zoom during their slice (0 = no movement)
IMAGE_ZOOM=0.12

# Captions
CAPTION_FONT=Arial
CAPTION_FONT_SIZE=84
WORDS_PER_CAPTION=4
